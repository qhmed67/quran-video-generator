# Quran Foundation (quran.com v4) OAuth2 client credentials.
# Create these in your QF app dashboard (api.quran.foundation / quran.foundation).
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# Token endpoint. Production default below; for the Prelive (test) environment use:
#   https://prelive-oauth2.quran.foundation/oauth2/token
QF_TOKEN_ENDPOINT=https://oauth2.quran.foundation/oauth2/token

# API base host (used server-side by the proxy). Prelive: https://apis-prelive.quran.foundation
QF_API_BASE=https://apis.quran.foundation

# API base including path (used client-side for content requests). Prelive:
#   https://apis-prelive.quran.foundation/content/api/v4
VITE_QF_API_BASE=https://apis.quran.foundation/content/api/v4