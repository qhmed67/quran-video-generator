{
  "name": "quran-video-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:browser": "node tests/golden/run.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:browser && npm run test:gate && npm run build",
    "test:gate": "node tests/gate/style-editing.mjs"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^1.94.0",
    "playwright": "^1.62.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.1.1"
  }
}
