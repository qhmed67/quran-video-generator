{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "redesign video creator/**",
    ".playwright-mcp/**",
    ".idea/**",
    "tests/probe-*.mjs",
    "tests/export-loop-results/**",
    "tests/golden/baselines/**"
  ],
  "rules": {
    "no-await-in-loop": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-add-event-listener": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "import/no-unassigned-import": "off",
    "no-misleading-character-class": "warn",
    // @vitejs/plugin-react uses the automatic JSX runtime: React does not
    // need to be in scope, so this rule only produces false positives.
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/no-array-index-key": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^@qvg/platform"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "api/**/*.ts",
        "vite.config.ts",
        "scripts/**",
        "tests/**",
        "**/*.test.ts",
        "tests/**/*.mjs"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": ["packages/core/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@qvg/"
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "fetch",
              "localStorage",
              "indexedDB",
              "navigator",
              "Audio",
              "Image"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/render/**/*.ts",
        "src/render/**/*.ts",
        "packages/data/**/*.ts",
        "src/data/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@qvg/(data|platform|render|ui)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/**/*.ts", "src/components/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@qvg/platform"
              }
            ]
          }
        ]
      }
    }
  ]
}
